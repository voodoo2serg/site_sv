[Unit]
Description=Sergey Vodopetov website (Next.js)
After=network.target

[Service]
Type=simple
User=site-sv
Group=site-sv
WorkingDirectory=/srv/site_sv
Environment=NODE_ENV=production
EnvironmentFile=/etc/site-sv.env
ExecStart=/usr/bin/node /srv/site_sv/node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 3000
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/site-sv /srv/site_sv/.next/cache

[Install]
WantedBy=multi-user.target
