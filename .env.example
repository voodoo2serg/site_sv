# Public canonical origin; set BEFORE the production build.
NEXT_PUBLIC_SITE_URL=https://example.com
# VPS only: persistent directory outside the git checkout, writable by the app user.
CONTENT_DIRECTORY=/var/lib/site-sv
# VPS editor (pre-cutover / break-glass only): unique random password (24+ characters); never commit it.
EDITOR_PASSWORD=
# Sites only: keep empty on a VPS. Never enable development preview in production.
OWNER_PRIVATE_EDITOR=
# Voronka CRM (outbound lead.created; HMAC wire как solo_pr — x-solo-* + idempotency-key)
VORONKA_WEBHOOK_URL=
VORONKA_WEBHOOK_SECRET=
# Optional: DEFAULT_PROJECT_ID override in Voronka inbox (project_id on lead.created)
VORONKA_PROJECT_ID=
# Set VORONKA_ENABLED=false to accept leads locally without POST (dev only)
VORONKA_ENABLED=true

# Keycloak OIDC BFF for /edit/ (AUTH-208). Disabled until ALL required fields are set.
# Never commit actual credentials. Identity = issuer + sub (not email).
EDITOR_OIDC_ISSUER=https://auth.solo-pr.ru/realms/solo-pr
EDITOR_OIDC_CLIENT_ID=site-sv-editor
EDITOR_OIDC_CLIENT_SECRET=
EDITOR_OIDC_REDIRECT_URI=https://vodopetov.ru/api/editor-oidc/callback
# Exact Keycloak subject(s) allowed as editor, comma-separated. NOT an email.
EDITOR_OIDC_OWNER_SUB=
# Random >=32 character independent HMAC key for editor OIDC session cookies.
EDITOR_OIDC_SESSION_SECRET=
# HTTPS address of SIGNAL /api/v1/access/resolve; no public browser credentials.
SIGNAL_ACCESS_RESOLVE_URL=
# Dedicated >=32 character key shared only with Signal for app_id=site_sv_editor.
SIGNAL_ACCESS_SIGNING_KEY=
# After SSO smoke works: set to 1 so EDITOR_PASSWORD is not a hidden bypass.
EDITOR_OIDC_CUTOVER=0
# Optional emergency password after cutover (audited). Keep 0 in normal operation.
EDITOR_OIDC_BREAK_GLASS=0
