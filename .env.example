# Public canonical origin; set BEFORE the production build.
NEXT_PUBLIC_SITE_URL=https://example.com
# VPS only: persistent directory outside the git checkout, writable by the app user.
CONTENT_DIRECTORY=/var/lib/site-sv
# VPS editor: generate a unique random password (24+ characters); never commit it.
EDITOR_PASSWORD=
# Sites only: keep empty on a VPS. Never enable development preview in production.
OWNER_PRIVATE_EDITOR=
# Voronka CRM (outbound lead.created; HMAC wire как solo_pr — x-solo-* + idempotency-key)
VORONKA_WEBHOOK_URL=
VORONKA_WEBHOOK_SECRET=
# Optional: DEFAULT_PROJECT_ID override in Voronka inbox (project_id on lead.created)
VORONKA_PROJECT_ID=
# Set VORONKA_ENABLED=false to accept leads locally without POST (dev only)
VORONKA_ENABLED=true
